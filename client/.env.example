# ==============================================================================
# EcoSaathi Frontend Environment Variables Example
# Copy this file to .env and replace the placeholder values with your real keys
# ==============================================================================

# Geoapify API Key for Leaflet Map Tiles & Reverse Geocoding
# Get your free key at: https://www.geoapify.com/
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Backend API URL
# For local development: http://localhost:5000
# For live production on Render/Railway: https://your-backend-app.onrender.com
VITE_API_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000
