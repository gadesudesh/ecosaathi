# ==============================================================================
# EcoSaathi Backend Environment Variables Example
# Copy this file to .env and replace the placeholder values with your real keys
# ==============================================================================

# Server Port
PORT=5000

# MongoDB Atlas Database Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecosaathi?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecosaathi?retryWrites=true&w=majority

# JSON Web Token Secret for user authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Geoapify API Key (used for road distance, duration & routing)
# Free key available at: https://www.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Central Waste Depot / Station Starting Coordinates (Default: Mumbai)
DEPOT_LAT=19.0760
DEPOT_LNG=72.8777

# Allowed Frontend Client URL (for CORS)
# For local development: http://localhost:5173
# For production: https://your-frontend.vercel.app or *
CLIENT_URL=http://localhost:5173
